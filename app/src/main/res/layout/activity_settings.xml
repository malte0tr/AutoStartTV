<?xml version="1.0" encoding="utf-8"?>
<!-- Phones and tablets: one column. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_pad_h"
        android:paddingTop="@dimen/page_pad_v"
        android:paddingEnd="@dimen/page_pad_h"
        android:paddingBottom="@dimen/page_pad_v">

        <include layout="@layout/part_settings_header" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="@dimen/section_gap" />

        <include layout="@layout/part_settings_rows" />
    </LinearLayout>
</ScrollView>
