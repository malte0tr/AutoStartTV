<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/rule_heavy"
        android:background="@color/rule_heavy" />

    <include android:id="@+id/row_delay" layout="@layout/row" />
    <include android:id="@+id/row_wake" layout="@layout/row" />
    <include android:id="@+id/row_permission" layout="@layout/row" />

    <LinearLayout
        style="@style/Note"
        android:layout_marginTop="16dp">

        <TextView
            style="@style/Text.Bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/delay_explanation_title"
            android:textColor="@color/text"
            android:textSize="@dimen/text_body" />

        <TextView
            style="@style/Text.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxWidth="560dp"
            android:text="@string/delay_explanation" />
    </LinearLayout>

    <LinearLayout
        style="@style/Note"
        android:layout_marginTop="8dp">

        <TextView
            style="@style/Text.Bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/wake_explanation_title"
            android:textColor="@color/text"
            android:textSize="@dimen/text_body" />

        <TextView
            style="@style/Text.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxWidth="560dp"
            android:text="@string/wake_explanation" />
    </LinearLayout>

    <LinearLayout
        style="@style/Note"
        android:layout_marginTop="8dp">

        <TextView
            style="@style/Text.Bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/permission_explanation_title"
            android:textColor="@color/text"
            android:textSize="@dimen/text_body" />

        <TextView
            style="@style/Text.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxWidth="560dp"
            android:text="@string/permission_explanation" />
    </LinearLayout>
</merge>
