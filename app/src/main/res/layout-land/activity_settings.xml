<?xml version="1.0" encoding="utf-8"?>
<!-- Phones in landscape: title left, settings right (scrollable). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:baselineAligned="false"
    android:orientation="horizontal"
    android:paddingStart="@dimen/page_pad_h"
    android:paddingEnd="@dimen/page_pad_h">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="2"
        android:orientation="vertical"
        android:paddingTop="@dimen/page_pad_top">

        <include layout="@layout/part_settings_header" />
    </LinearLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/column_gap"
        android:layout_weight="3">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="0dp"
            android:paddingTop="@dimen/page_pad_top"
            android:paddingBottom="@dimen/page_pad_v">

            <include layout="@layout/part_settings_rows" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
