<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/red" android:state_focused="true" />
    <item android:drawable="@color/red" android:state_selected="true" />
    <item android:drawable="@color/red" android:state_pressed="true" />
    <!-- Default: white with a thin black rule at the bottom. -->
    <item>
        <layer-list>
            <item android:drawable="@color/black" />
            <item android:bottom="1dp" android:drawable="@color/white" />
        </layer-list>
    </item>
</selector>
